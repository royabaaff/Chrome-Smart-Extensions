{
  "manifest_version": 3,
  "name": "Smart RTL Fixer",
  "version": "2.0",
  "description": "راست‌چین و اصلاح فونت هوشمند صفحات با قابلیت اعمال خودکار روی دامنه‌های دلخواه",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Smart RTL Fixer"
  },
  "background": {
    "service_worker": "background.js"
  }
}