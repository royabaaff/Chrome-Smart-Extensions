{
  "manifest_version": 3,
  "name": "Smart RAM Saver",
  "version": "2.1",
  "description": "بهینه‌سازی هوشمند مصرف رم و فریز کردن تب‌های غیرکاربردی",
  "permissions": [
    "tabs",
    "storage",
    "alarms"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "ON-16.png",
      "32": "ON-32.png",
      "48": "ON-48.png",
      "128": "ON-128.png"
    }
  },
  "icons": {
    "16": "ON-16.png",
    "48": "ON-48.png",
    "128": "ON-128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}