{
  "manifest_version": 3,
  "name": "Smart SOCKS Proxy",
  "version": "2.3",
  "description": "مدیریت و اتصال هوشمند پروکسی ساکس با تشخیص خودکار IP",
  "permissions": [
    "proxy",
    "storage"
  ],
  "host_permissions": [
    "https://ipwho.is/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "OFF-16.png",
      "32": "OFF-32.png",
      "48": "OFF-48.png",
      "128": "OFF-128.png"
    },
    "default_title": "Smart SOCKS Proxy"
  },
  "icons": {
    "16": "ON-16.png",
    "48": "ON-48.png",
    "128": "ON-128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}