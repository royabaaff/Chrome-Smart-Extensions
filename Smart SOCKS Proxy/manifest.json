{
  "manifest_version": 3,
  "name": "Smart SOCKS Proxy",
  "version": "2.1",
  "description": "مدیریت حرفه‌ای پروکسی SOCKS به همراه نمایش لحظه‌ای آی‌پی و کشور",
  "permissions": [
    "proxy",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://ipwho.is/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Smart SOCKS Proxy"
  },
  "background": {
    "service_worker": "background.js"
  }
}